module(
    name = "extension",
    version = "0.0.0",
)

bazel_dep(name = "rules_playwright", version = "0.5.3", dev_dependency = True)
bazel_dep(name = "rules_python", version = "1.8.5")
bazel_dep(name = "sphinxdocs", version = "2.0.2")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.12")
python.toolchain(python_version = "3.12")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = "3.12",
    requirements_lock = "//:pypi.lock",
)
use_repo(pip, "pypi")

# Pin Playwright to 1.46.0 to match rules_playwright 0.5.3 capabilities
# and avoid 404 errors when downloading browsers
playwright = use_extension("@rules_playwright//playwright:extensions.bzl", "playwright")
playwright.repo(
    name = "playwright",
    playwright_version = "1.46.0",
)
use_repo(playwright, "playwright")
