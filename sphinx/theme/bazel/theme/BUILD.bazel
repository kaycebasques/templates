load("@rules_python//python:defs.bzl", "py_library")
load("@rules_python//python:packaging.bzl", "py_package", "py_wheel")

py_library(
    name = "theme",
    srcs = ["__init__.py"],
    data = [
        "theme.conf",
        "genindex.html",
        "layout.html",
        "page.html",
        "search.html",
    ],
    visibility = ["//visibility:public"],
)

py_package(
    name = "theme_pkg",
    packages = ["theme"],
    deps = [":theme"],
)

py_wheel(
    name = "wheel",
    distribution = "sphinx_theme_bazel",
    version = "0.0.0",
    deps = [":theme_pkg"],
)
